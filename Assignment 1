students = {}

print("--- Adding Students ---")

students[101] = ("Alice", "Computer Science", 85)
students[102] = ("Bob", "Mechanical", 78)
students[103] = ("Charlie", "Electrical", 92)
print("Students added successfully.")

print("\n--- Updating Student 102 ---")

students[102] = ("Bob", "Mechanical", 82) 
print("Student 102 updated.")

print("\n--- Deleting Student 101 ---")
del students[101]
print("Student 101 deleted.")

print("\n--- Final Student Records ---")

student_list = list(students.items())

for roll_no, info in student_list:
    name = info[0]
    branch = info[1]
    marks = info[2]
    print(f"Roll No: {roll_no} | Name: {name} | Branch: {branch} | Marks: {marks}")
